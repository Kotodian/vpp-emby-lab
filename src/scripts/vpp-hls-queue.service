[Unit]
Description=Emby HLS generation queue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/emby-hls-queue.py run --mode auto --segment-time 4 --max-width 1920
Nice=10
IOSchedulingClass=idle
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
