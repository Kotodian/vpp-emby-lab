[Unit]
Description=VPP DPDK WAN lab
After=network-online.target dpdk.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=forking
PIDFile=/run/vpp-dpdk/vpp.pid
ExecStart=/usr/local/sbin/vpp-f0-start.sh
ExecStop=/usr/local/sbin/vpp-f0-stop.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
